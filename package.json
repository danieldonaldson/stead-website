{
  "name": "stead-website",
  "version": "1.0.0",
  "description": "stead. website built with Astro",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm compile:css && astro check && astro build",
    "compile:css": "sass --silence-deprecation=import,color-functions,slash-div,global-builtin assets/scss/now-ui-kit.scss public/css/now-ui-kit.css && cp assets/css/stead.css public/css/stead.css",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieldonaldson/Silience-Website.git"
  },
  "packageManager": "pnpm@11.4.0",
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danieldonaldson/Silience-Website/issues"
  },
  "homepage": "https://github.com/danieldonaldson/Silience-Website#readme",
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^6.4.6",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "sass": "^1.100.0",
    "sharp": "^0.35.2",
    "vitest": "^4.1.8"
  }
}